  "tools": [
    {
      "name": "flux_generate_image",
      "description": "Generate AI images from a text prompt using Flux.\n\n    Flux is a family of fast, high-quality image generation models by Black Forest Labs.\n    Different models offer different tradeoffs between speed, quality, and capabilities.\n\n    Use this when:\n    - You want to create new images from a text description\n    - You need high-quality AI-generated artwork or photos\n    - You want fast image generation with good prompt following\n\n    For editing existing images, use flux_edit_image instead.\n\n    Returns:\n        Task ID and generated image information including URLs.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "description": "Description of the image to generate. Be descriptive about style, subject, lighting, and composition. Examples: 'A majestic mountain landscape at golden hour, photorealistic', 'Cyberpunk street scene with neon lights and rain, cinematic', 'Minimalist logo design of a phoenix, vector art style'",
            "title": "Prompt",
            "type": "string"
          },
          "size": {
            "description": "Required image size. For flux-dev: pixel dimensions like '1024x1024' (256-1440px, multiples of 32). For flux-2-flex/pro/max: pixel dimensions (x >= 64, multiples of 32). For kontext models: image ratios like '1:1', '16:9', '9:16', '4:3', '3:2', '2:3', '4:5', '5:4', '3:4', '21:9', '9:21'.",
            "title": "Size",
            "type": "string"
          },
          "model": {
            "default": "flux-dev",
            "description": "Flux model to use for generation. Options:\n- flux-dev: Fast development model, good balance of speed and quality (default)\n- flux-pro: Higher quality production model\n- flux-2-flex: Flux 2 flexible model, pixel sizes (x >= 64, multiple of 32)\n- flux-2-pro: Flux 2 professional model, high quality\n- flux-2-max: Flux 2 maximum-quality model\n- flux-2-klein: Flux 2 klein model, efficient generation\n- flux-kontext-pro: Context-aware model for editing and style transfer\n- flux-kontext-max: Maximum context model for complex editing tasks",
            "enum": [
              "flux-dev",
              "flux-pro",
              "flux-kontext-pro",
              "flux-kontext-max",
              "flux-2-flex",
              "flux-2-pro",
              "flux-2-max",
              "flux-2-klein"
            ],
            "title": "Model",
            "type": "string"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of images to generate. Only supported for generate action. Default is 1.",
            "title": "Count"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Webhook callback URL for asynchronous notifications. When provided, the API will POST to this URL when the image is generated.",
            "title": "Callback Url"
          }
        },
        "required": [
          "prompt",
          "size"
        ],
        "title": "flux_generate_imageArguments"
      }
    },
    {
      "name": "flux_edit_image",
      "description": "Edit an existing image using Flux with a text prompt.\n\n    This allows you to modify an existing image based on a text description.\n    The kontext models (flux-kontext-pro, flux-kontext-max) are specifically\n    designed for high-quality image editing and style transfer.\n\n    Use this when:\n    - You want to modify or transform an existing image\n    - You want to change specific elements in an image\n    - You want to apply style changes or artistic effects\n    - You want to add, remove, or replace objects in an image\n\n    For generating new images from scratch, use flux_generate_image instead.\n\n    Returns:\n        Task ID and edited image information including URLs.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "description": "Description of how to edit the image. Be specific about what changes to make. Examples: 'Change the background to a sunset beach', 'Add sunglasses to the person', 'Make it look like a watercolor painting', 'Replace the car with a bicycle'",
            "title": "Prompt",
            "type": "string"
          },
          "image_url": {
            "description": "URL of the image to edit. Must be a direct image URL (JPEG, PNG, etc.), not a web page containing an image.",
            "title": "Image Url",
            "type": "string"
          },
          "size": {
            "description": "Required output image size. For kontext models: aspect ratios like '1:1', '16:9'. For other models: pixel dimensions like '1024x1024'.",
            "title": "Size",
            "type": "string"
          },
          "model": {
            "default": "flux-kontext-pro",
            "description": "Flux model to use for editing. Recommended models for editing:\n- flux-kontext-pro: Best for context-aware editing and style transfer (recommended)\n- flux-kontext-max: Maximum context for complex edits\n- flux-dev: Basic editing support\nOther models also support editing but kontext models give best results.",
            "enum": [
              "flux-dev",
              "flux-pro",
              "flux-kontext-pro",
              "flux-kontext-max",
              "flux-2-flex",
              "flux-2-pro",
              "flux-2-max",
              "flux-2-klein"
            ],
            "title": "Model",
            "type": "string"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Webhook callback URL for asynchronous notifications.",
            "title": "Callback Url"
          }
        },
        "required": [
          "prompt",
          "image_url",
          "size"
        ],
        "title": "flux_edit_imageArguments"
      }
    },
