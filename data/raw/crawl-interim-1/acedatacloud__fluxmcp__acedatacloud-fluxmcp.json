    {
      "name": "flux_get_task",
      "description": "Query the status and result of a Flux image or video generation task.\n\n    Use this to check if a generation is complete and retrieve the resulting\n    image/video URLs and metadata.\n\n    Use this when:\n    - You want to check if an image generation has completed\n    - You need to retrieve image URLs from a previous generation\n    - You used async callback and want to check results later\n    - The initial generation returned a task_id without immediate results\n\n    Returns:\n        Task status and generation result including image URLs.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "description": "The task ID returned from a generation or edit request. This is the 'task_id' field from any flux_generate_image, flux_edit_image or a FLUX video tool response.",
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "flux_get_taskArguments"
      }
    },
    {
      "name": "flux_get_tasks_batch",
      "description": "Query multiple Flux image or video generation tasks at once.\n\n    Efficiently check the status of multiple tasks in a single request.\n    More efficient than calling flux_get_task multiple times.\n\n    Use this when:\n    - You have multiple pending generations to check\n    - You want to get status of several images at once\n    - You're tracking a batch of generations\n\n    Returns:\n        Status and result information for all queried tasks.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_ids": {
            "description": "List of task IDs to query. Maximum recommended batch size is 50 tasks.",
            "items": {
              "type": "string"
            },
            "title": "Task Ids",
            "type": "array"
          }
        },
        "required": [
          "task_ids"
        ],
        "title": "flux_get_tasks_batchArguments"
      }
    },
