    {
      "name": "paper_get_metadata",
      "description": "Return comprehensive metadata for an academic paper searched by title.\n\nQueries Semantic Scholar first (richest metadata), then falls back to arXiv.\n\nReturns JSON with: title, authors, abstract, year, venue, doi, arxiv_id,\nsemantic_scholar_id, citation_count, reference_count, fields_of_study,\npublication_types, publication_date, is_open_access, open_access_pdf, tldr.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "params": {
            "additionalProperties": false,
            "description": "{ paper_title: str }",
            "properties": {
              "paper_title": {
                "description": "Full or partial title of the academic paper to search for. Example: 'Attention Is All You Need'",
                "maxLength": 500,
                "minLength": 3,
                "type": "string"
              }
            },
            "required": [
              "paper_title"
            ],
            "type": "object"
          }
        },
        "required": [
          "params"
