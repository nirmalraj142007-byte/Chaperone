    {
      "name": "doi_get_metadata",
      "description": "Resolve a DOI to comprehensive paper metadata from multiple authoritative sources.\n\nThis is the reverse of paper_get_metadata: given a DOI you already know,\nretrieve everything about the paper without needing its title.\n\nData is merged from three complementary sources (all queried in parallel):\n  1. Crossref  — canonical DOI registry; best for bibliographic data,\n                 publisher, volume/issue/page, funders, license.\n  2. Semantic Scholar — adds citation count, references, fields of study,\n                        TL;DR, and open-access PDF link.\n  3. Unpaywall — adds detailed open-access status and every known PDF URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "params": {
            "additionalProperties": false,
            "description": "{ doi: str }\nAccepts bare DOI or full URL, e.g.:\n  \"10.1145/3442188.3445922\"\n  \"https://doi.org/10.1145/3442188.3445922\"",
            "properties": {
              "doi": {
                "description": "The Digital Object Identifier (DOI) of the paper. Accepts bare DOI or full URL form. Examples: '10.1145/3442188.3445922'  or  'https://doi.org/10.1145/3442188.3445922'",
                "maxLength": 300,
                "minLength": 5,
                "type": "string"
              }
            },
            "required": [
              "doi"
            ],
            "type": "object"
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      }
    }
