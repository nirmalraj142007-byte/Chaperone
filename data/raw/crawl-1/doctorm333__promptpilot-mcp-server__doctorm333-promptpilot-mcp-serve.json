    {
      "name": "build_prompt",
      "description": "Build an optimized prompt from subject + style/lighting/camera/mood/color/quality options",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Main subject of the image"
          },
          "style": {
            "type": "string",
            "enum": [
              "photorealistic",
              "cinematic",
              "anime",
              "digitalArt",
              "oilPainting",
              "watercolor",
              "3dRender",
              "pixelArt",
              "comicBook",
              "cyberpunk",
              "fantasy",
              "minimalist"
            ],
            "description": "Visual style"
          },
          "lighting": {
            "type": "string",
            "enum": [
              "natural",
              "studio",
              "neon",
              "goldenHour",
              "dramatic",
              "soft",
              "backlit"
            ],
            "description": "Lighting type"
          },
          "camera": {
            "type": "string",
            "enum": [
              "closeUp",
              "wideAngle",
              "portrait",
              "aerial",
              "macro",
              "lowAngle",
              "highAngle"
            ],
            "description": "Camera angle"
          },
          "mood": {
            "type": "string",
            "enum": [
              "happy",
              "mysterious",
              "epic",
              "calm",
              "dark",
              "romantic",
              "energetic"
            ],
            "description": "Mood/atmosphere"
          },
          "color": {
            "type": "string",
            "enum": [
              "vibrant",
              "pastel",
              "monochrome",
              "warm",
              "cold",
              "neon"
            ],
            "description": "Color palette"
          },
          "quality_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "8k",
                "detailed",
                "award",
                "professional",
                "masterpiece"
              ]
            },
            "description": "Quality enhancement tags"
          }
        },
        "required": [
          "subject"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "generate_image",
      "description": "Generate an image using Pollinations API. Returns a URL to the generated image.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for image generation"
          },
          "model": {
            "type": "string",
            "default": "flux",
            "description": "Model ID (default: flux)"
          },
          "width": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "default": 1024,
            "description": "Image width"
          },
          "height": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "default": 1024,
            "description": "Image height"
          },
          "enhance": {
            "type": "boolean",
            "default": true,
            "description": "Enhance prompt with AI"
          },
          "seed": {
            "type": "number",
            "description": "Seed for reproducibility"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "generate_video",
      "description": "Generate a video using Pollinations API. Returns a URL to the generated video.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for video generation"
          },
          "model": {
            "type": "string",
            "default": "grok-video",
            "description": "Model ID (default: grok-video)"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "1:1",
              "16:9",
              "9:16"
            ],
            "default": "1:1",
            "description": "Aspect ratio"
          },
          "duration": {
            "type": "number",
            "description": "Duration in seconds (model-dependent)"
          },
          "seed": {
            "type": "number",
            "description": "Seed for reproducibility"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "generate_audio",
      "description": "Generate audio (speech or music) using Pollinations API. Returns a URL to the generated audio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text for speech or music prompt"
          },
          "model": {
            "type": "string",
            "enum": [
              "elevenlabs",
