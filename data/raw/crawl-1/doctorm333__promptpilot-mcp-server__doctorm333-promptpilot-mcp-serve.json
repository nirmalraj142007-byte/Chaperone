                  "default": 1024
                },
                "seed": {
                  "type": "number"
                }
              },
              "required": [
                "prompt"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Array of image prompts to generate (max 10)"
          }
