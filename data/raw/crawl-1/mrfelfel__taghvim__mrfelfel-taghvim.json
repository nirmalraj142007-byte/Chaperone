            "description": "Unit for add/subtract"
          },
          "target_date": {
            "type": "string",
            "description": "Second date for diff or comparison"
          },
          "weekday": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ],
            "description": "Weekday name for next_weekday/previous_weekday"
          },
          "period": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ],
            "description": "Period for start_of/end_of"
          },
          "timezone": {
            "type": "string",
            "default": "UTC"
          },
          "calendar": {
            "type": "string",
            "enum": [
              "gregorian",
              "persian",
              "iso-week"
            ],
            "default": "gregorian"
          }
