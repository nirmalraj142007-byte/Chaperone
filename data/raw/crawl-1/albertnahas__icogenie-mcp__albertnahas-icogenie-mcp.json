          "bundleId": {
            "type": "string",
            "description": "ID from generate_bundle result (for bundles)"
          },
          "outputPath": {
            "type": "string",
            "description": "Where to save the ZIP file"
          },
          "removeBackground": {
            "type": "boolean",
            "default": false,
            "description": "Remove background from illustrations (transparent)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
