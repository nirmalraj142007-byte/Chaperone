{
  "serverId": "albertnahas__icogenie-mcp__albertnahas-icogenie-mcp",
  "status": "BOOTED",
  "tools": [
    {
      "name": "generate_icon",
      "description": "Generate an AI-powered icon preview. Costs 1 credit. Keep prompts minimal - the system normalizes them internally. Verbose descriptions create cluttered icons. Returns generationId for download. Note: previews are watermarked and low-resolution — for display/evaluation only, not production use. Use download_icon to get the final unwatermarked assets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Icon concept to generate. Keep it minimal - the system normalizes and enhances prompts internally. Verbose descriptions create cluttered icons."
          },
          "style": {
            "type": "string",
            "enum": [
              "solid",
              "outline",
              "illustration"
            ],
            "default": "solid",
            "description": "Icon style: solid (filled shapes), outline (stroked lines), or illustration (colorful, detailed)"
          },
          "variations": {
            "type": "number",
            "enum": [
              1,
              2,
              4
            ],
            "default": 1,
            "description": "Number of variations (1, 2, or 4)"
          },
          "referenceImagePath": {
            "type": "string",
            "description": "Local file path to reference image for style extraction"
          },
          "referenceImage": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "description": "Base64-encoded image data"
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            },
            "required": [
              "data",
              "mimeType"
            ],
            "additionalProperties": false,
            "description": "Base64-encoded reference image"
          },
          "force": {
            "type": "boolean",
            "description": "Proceed even when the AI detects style conflicts with the prompt"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "regenerate_icon",
      "description": "Regenerate a specific icon variation. Costs 1 credit. Returns 4 candidate previews + regenToken. Use confirm_regeneration with regenToken and selectedIndex (0-3) to finalize.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "For single icon variations"
          },
          "bundleId": {
            "type": "string",
            "description": "For bundle icons"
          },
          "index": {
            "type": "number",
            "description": "Which variation/icon to regenerate (0-based)"
          },
          "prompt": {
            "type": "string",
            "description": "Custom refinement prompt"
          }
        },
        "required": [
          "index"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "confirm_regeneration",
      "description": "Finalize a regeneration by selecting one of the 4 candidates. Free — credit was charged during regenerate_icon.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "regenToken": {
            "type": "string",
            "description": "Token from regenerate_icon result"
          },
          "selectedIndex": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "description": "Which candidate to finalize (0-3)"
          }
        },
        "required": [
          "regenToken",
          "selectedIndex"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "check_credits",
      "description": "Check the current credit balance and account information. Free to use.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "download_icon",
      "description": "Download the final SVG + PNG package for an icon. Costs 5 credits (single) or 4 credits/icon (bundle). Provide outputPath to save to file. Always save to the user's working directory with a descriptive filename.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
