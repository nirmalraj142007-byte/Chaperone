            "default": "solid",
            "description": "Icon style: solid (filled shapes), outline (stroked lines), or illustration (colorful, detailed)"
          },
          "referenceImagePath": {
            "type": "string",
            "description": "Local file path to reference image"
          },
          "bundleId": {
            "type": "string",
