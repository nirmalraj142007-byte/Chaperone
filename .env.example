# Copy to .env and fill in real values for local, non-docker-compose runs.
# Every value below is a placeholder — none of them are real credentials.
# docker-compose.yml sets its own equivalents directly in the compose file
# for the containerized stack; this file is for running packages/gateway or
# a script (pnpm crawl:*, pnpm advisory:run-local, ...) directly on the host.
#
# packages/config validates every one of these at process start (zod schema,
# packages/config/src/index.ts) and refuses to boot on a missing or
# malformed required value — see ConfigError. Never commit a real .env.

AWS_REGION=us-east-1
DDB_ENDPOINT=http://localhost:8000
DDB_TABLE_PREFIX=chaperone
HOUSEHOLD_ID=household-demo

# JSON array of {id, url, label} — one entry per upstream MCP server.
CHAPERONE_UPSTREAMS=[{"id":"grocery","url":"http://localhost:4000/mcp","label":"Household Grocery"}]

# Which provider backs the two uses that want a model: "groq" (default) or
# "bedrock". Bedrock access was declined for this account (docs/LIMITATIONS.md);
# BedrockModelProvider is untouched, so "bedrock" is a config-only switch back.
MODEL_PROVIDER=groq

# Required when MODEL_PROVIDER=groq and you run a model-calling script
# (pnpm advisory:live-check, advisory:run-local, eval:baseline2 --capture).
# A secret: keep it in .env only, never commit it. In AWS the Lambda reads it
# from Secrets Manager instead (docs/AWS-BUILDER.md).
GROQ_API_KEY=

# Optional. Model ids for the two uses. Both default to openai/gpt-oss-120b on
# Groq (an open-weight model; id confirmed against Groq's live models endpoint
# 2026-10-03). Bedrock has no default: with MODEL_PROVIDER=bedrock these must be
# set, and the id confirmed to exist in AWS_REGION first.
#   ADVISORY_MODEL_ID  - packages/advisory's diff-scoring calls.
#   BASELINE_MODEL_ID  - packages/eval's baseline-2 attack-corpus run.
ADVISORY_MODEL_ID=openai/gpt-oss-120b
BASELINE_MODEL_ID=openai/gpt-oss-120b

# Optional. Only needed for pnpm crawl:commit-recency and other crawler
# scripts that call the GitHub API. A fine-grained PAT with no scopes beyond
# public-repo read access — never a classic token with write/admin scopes.
GITHUB_TOKEN=

LOG_LEVEL=info
PORT=3000

# Comma-separated. A trailing ":*" matches any port on that origin.
GATEWAY_ORIGIN_ALLOWLIST=http://localhost:*

# "true" binds every interface (needed inside a container); "false" (the
# default) binds loopback only. Leave "false" outside a container.
BIND_ALL=false

MCP_APP_ENABLED=true

# "development" (the default) or "production". Gates whether the gateway
# sends Strict-Transport-Security — see packages/gateway/src/security.ts.
# Leave "development" unless this process is genuinely behind TLS.
CHAPERONE_ENV=development

# Baked into docker/gateway.Dockerfile at build time for a real deployment;
# harmless placeholders for a local run.
CHAPERONE_VERSION=0.0.0
CHAPERONE_COMMIT=unknown
