exports[`renderConsentCardHtml — all seven states > batch: a collapsed <details> list, one open, no bulk-approve control 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Chaperone consent card</title>
<style>
:root { color-scheme: light dark; }
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 16px;
  font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
  background: light-dark(#ECEAE4, #201F1C);
  color: light-dark(#232321, #ECE9E2);
  direction: ltr;
}
.card {
  max-width: 480px;
  margin: 0 auto;
  background: light-dark(#F7F5F0, #2A2925);
  border-radius: 10px;
  overflow: hidden;
  unicode-bidi: isolate;
}
