{
  "name": "@chaperone/assistant-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A simulated Alexa+ experience: a rule-based stand-in assistant that talks to the Chaperone gateway over real MCP Streamable HTTP and hosts the consent card as an MCP App.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run --root ../.. packages/assistant-sim"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@chaperone/mcp-app": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
