{
  "name": "chaperone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "depcruise": "dependency-cruiser packages",
    "typecheck": "tsc -b && tsc --noEmit -p packages/ledger/scripts",
    "ddb:migrate": "tsx packages/ledger/scripts/migrate.ts",
    "ddb:seed": "tsx packages/ledger/scripts/seed.ts",
    "verify-ledger": "tsx packages/ledger/scripts/verify-ledger.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "16.10.4",
    "eslint": "^9.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
