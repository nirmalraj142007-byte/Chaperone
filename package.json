{
  "name": "chaperone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run && echo \"(skipped: spec/resumption.test.ts, spec/long-stream.test.ts -- these need a running docker compose stack. Run 'pnpm test:stack' against one, or 'pnpm test:all' to run both.)\"",
    "test:stack": "vitest run --config spec/stack.vitest.config.ts",
    "test:all": "vitest run && vitest run --config spec/stack.vitest.config.ts",
    "spec": "vitest run --config spec/vitest.config.ts",
    "test:resume": "vitest run --config spec/stack.vitest.config.ts spec/resumption.test.ts",
    "resume-demo": "tsx scripts/resume-demo.ts",
    "lint": "eslint .",
    "depcruise": "dependency-cruiser packages",
    "check-claims": "tsx scripts/check-claims.ts",
    "typecheck": "tsc -b && tsc --noEmit -p packages/ledger/scripts && tsc --noEmit -p packages/crawler/scripts && tsc --noEmit -p packages/gateway/scripts && tsc --noEmit -p spec && tsc --noEmit -p scripts",
    "ddb:migrate": "tsx packages/ledger/scripts/migrate.ts",
    "ddb:seed": "tsx packages/ledger/scripts/seed.ts",
    "ddb:dump": "tsx packages/ledger/scripts/dump.ts",
    "verify-ledger": "tsx packages/ledger/scripts/verify-ledger.ts",
    "pin:bootstrap": "tsx packages/gateway/scripts/pin-bootstrap.ts",
    "crawl:assemble": "tsx packages/crawler/scripts/assemble.ts",
    "crawl:infer-install": "tsx packages/crawler/scripts/infer-install.ts",
    "crawl:run": "tsx packages/crawler/scripts/crawl.ts",
    "crawl:commit-recency": "node --env-file-if-exists=.env --import tsx packages/crawler/scripts/commit-recency.ts",
    "crawl:capability-report": "tsx packages/crawler/scripts/capability-report.ts",
    "crawl:boot-rate": "tsx packages/crawler/scripts/boot-rate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "16.10.4",
    "eslint": "^9.13.0",
    "express": "^5.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
