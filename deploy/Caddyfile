# Caddy in front of the gateway on the EC2 host (docs/RUNBOOK.md).
#
# What this file must keep true: a long-lived SSE stream is never cut or
# held back by the proxy. The resumable-stream claim is only as good as the
# hop in front of it.
#   - No `encode` directive. Compression buffers; nothing here enables it.
#   - `flush_interval -1` flushes every write to the client immediately,
#     instead of relying on Caddy's content-type sniffing for text/event-stream.
#   - No write timeout (Caddy's default is none) and no response-header
#     timeout, so a stream that is quiet between events is not closed.
#   - `idle` only bounds a *keep-alive connection with no request in flight*;
#     it never cuts an active stream. 10m is generous on purpose.
#
# CADDY_SITE is the public hostname in production (Caddy then obtains and
# renews a Let's Encrypt certificate by itself, over ports 80/443) and
# `:8080` in the local verification stack (plain HTTP, no certificate).
{
	servers {
		timeouts {
			read_header 30s
			idle 10m
		}
	}
}

{$CADDY_SITE} {
	# The exact path "/" is the static landing page (deploy/site/index.html,
	# mounted at /srv/site). Nothing else is served from disk. The page's
	# inline <style> and <script> are pinned by hash below, and
	# infra/test/landing-page.test.ts fails if either changes without this
	# policy following.
	handle / {
		root * /srv/site
		rewrite * /index.html
		header {
			Content-Security-Policy "default-src 'none'; style-src 'sha256-8EodjawKRhepH5kDUdgJ2KqMmvyPl0KP/tQDterXbGk='; script-src 'sha256-ScH3CxrhkE9ZDQJRGkQuBw7rJ7vzWntodhYUYpSHTtU='; connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Strict-Transport-Security "max-age=63072000; includeSubDomains"
			Cache-Control no-cache
		}
		file_server
	}

	# Every other path, /mcp, /healthz, /metrics and /api included, goes to
	# the gateway exactly as before.
	handle {
		reverse_proxy gateway:3000 {
			flush_interval -1
			transport http {
				dial_timeout 5s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
